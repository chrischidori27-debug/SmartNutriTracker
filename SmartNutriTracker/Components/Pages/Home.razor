@page "/"

<PageTitle>Inicio | SmartNutriTracker</PageTitle>

<div class="home-container">

    <!-- ENCABEZADO PRINCIPAL -->
    <section class="hero-section">

        <div class="hero-content">

            <span class="section-label">
                PLATAFORMA DE GESTIÓN NUTRICIONAL
            </span>

            <h1>
                Una mejor alimentación,
                <span>un mejor futuro.</span>
            </h1>

            <p>
                SmartNutriTracker es una plataforma diseñada para
                facilitar la gestión de alimentos, la planificación
                de menús y el seguimiento de información nutricional
                dentro del entorno escolar.
            </p>

            <div class="hero-actions">
                <NavLink href="login" class="primary-button">
                    Iniciar sesión
                    <span>→</span>
                </NavLink>

                <NavLink href="registro" class="secondary-button">
                    Crear una cuenta
                </NavLink>
            </div>

            <div class="hero-note">
                <span class="note-indicator"></span>
                COLEGIO INNOVARE · SISTEMA DE GESTIÓN NUTRICIONAL
            </div>

        </div>

        <div class="hero-visual">

            <div class="visual-glow"></div>

            <div class="nutrition-card">

                <div class="nutrition-card-header">
                    <div>
                        <span class="card-overline">SMART NUTRI</span>
                        <h3>Nutrición inteligente</h3>
                    </div>

                    <div class="card-symbol">SN</div>
                </div>

                <div class="nutrition-circle">
                    <div class="circle-inner">
                        <span>SN</span>
                        <small>INNOVARE</small>
                    </div>
                </div>

                <div class="nutrition-card-footer">
                    <div>
                        <span class="footer-dot"></span>
                        <span>Gestión de alimentos</span>
                    </div>

                    <span class="footer-status">ACTIVO</span>
                </div>

            </div>

            <div class="floating-label label-top">
                <span>01</span>
                Gestión nutricional
            </div>

            <div class="floating-label label-bottom">
                <span>02</span>
                Menús escolares
            </div>

        </div>

    </section>

    <!-- PRESENTACIÓN -->
    <section class="features-section">

        <div class="section-heading">
            <span class="section-label">NUESTRAS HERRAMIENTAS</span>

            <h2>
                Todo lo necesario para
                <span>gestionar mejor.</span>
            </h2>

            <p>
                Herramientas digitales que permiten organizar
                y consultar la información nutricional de manera sencilla.
            </p>
        </div>

        <div class="features-grid">

            <article class="feature-card">
                <div class="feature-number">01</div>

                <div class="feature-icon">＋</div>

                <h3>Gestión de alimentos</h3>

                <p>
                    Registra, consulta y administra alimentos
                    junto con sus características y valores nutricionales.
                </p>

                <span class="feature-link">ADMINISTRACIÓN</span>
            </article>

            <article class="feature-card">
                <div class="feature-number">02</div>

                <div class="feature-icon">▦</div>

                <h3>Menús diarios</h3>

                <p>
                    Organiza alimentos en menús para facilitar
                    la planificación de la alimentación escolar.
                </p>

                <span class="feature-link">PLANIFICACIÓN</span>
            </article>

            <article class="feature-card">
                <div class="feature-number">03</div>

                <div class="feature-icon">⌁</div>

                <h3>Información nutricional</h3>

                <p>
                    Consulta calorías, proteínas, carbohidratos,
                    grasas y otros valores de los alimentos.
                </p>

                <span class="feature-link">SEGUIMIENTO</span>
            </article>

            <article class="feature-card">
                <div class="feature-number">04</div>

                <div class="feature-icon">◇</div>

                <h3>Seguridad y usuarios</h3>

                <p>
                    Organiza el acceso al sistema mediante
                    usuarios, roles y mecanismos de seguridad.
                </p>

                <span class="feature-link">CONTROL DE ACCESO</span>
            </article>

        </div>

    </section>

    <!-- OBJETIVO -->
    <section class="objective-section">

        <div class="objective-content">
            <span class="section-label">NUESTRO PROPÓSITO</span>

            <h2>
                La tecnología al servicio
                de la nutrición escolar.
            </h2>

            <p>
                SmartNutriTracker busca contribuir a una mejor
                organización de la información alimentaria en
                el Colegio Innovare, proporcionando herramientas
                digitales para gestionar y consultar datos nutricionales.
            </p>
        </div>

        <div class="objective-decoration">
            <span class="decoration-top">SMART</span>
            <strong>SN</strong>
            <span class="decoration-bottom">NUTRITION TRACKER</span>
        </div>

    </section>

    <!-- PIE DE PÁGINA -->
    <footer class="home-footer">

        <div>
            <strong>SmartNutriTracker</strong>
            <span>Gestión inteligente de información nutricional.</span>
        </div>

        <span>© 2026 Colegio Innovare · Versión Beta</span>

    </footer>

</div>
