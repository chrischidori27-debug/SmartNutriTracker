@page "/login"
@rendermode InteractiveServer
<PageTitle>Iniciar sesión | SmartNutriTracker</PageTitle>

<div class="login-page">

    <div class="login-container">

        <div class="welcome-panel">

            <div class="brand">
                <div class="brand-icon">SN</div>
                <span>SmartNutriTracker</span>
            </div>

            <div class="welcome-content">
                <span class="welcome-tag">COLEGIO INNOVARE</span>

                <h1>
                    Cuida tu alimentación.<br />
                    Mejora tu bienestar.
                </h1>

                <p>
                    Una plataforma inteligente para gestionar,
                    monitorear y mejorar tus hábitos nutricionales
                    de manera sencilla.
                </p>

                <div class="feature">
                    <span class="feature-icon">01</span>
                    <div>
                        <strong>Seguimiento nutricional</strong>
                        <small>Controla tus hábitos alimenticios.</small>
                    </div>
                </div>

                <div class="feature">
                    <span class="feature-icon">02</span>
                    <div>
                        <strong>Información organizada</strong>
                        <small>Consulta tus datos de forma segura.</small>
                    </div>
                </div>
            </div>

            <div class="welcome-footer">
                SMARTNUTRITRACKER · VERSIÓN 1.0
            </div>

        </div>

        <div class="form-panel">

            <div class="mobile-brand">
                <div class="brand-icon">SN</div>
                <span>SmartNutriTracker</span>
            </div>

            <div class="form-content">

                <span class="form-tag">BIENVENIDO DE NUEVO</span>

                <h2>Iniciar sesión</h2>

                <p class="form-description">
                    Ingresa tus credenciales para acceder a tu cuenta.
                </p>

                <form @onsubmit="IniciarSesion"
                      @onsubmit:preventDefault>

                    <div class="input-group">
                        <label>Correo electrónico</label>

                        <div class="input-wrapper">
                            <span class="input-icon">✉</span>

                            <input type="email"
                                   placeholder="ejemplo@innovare.edu"
                                   @bind="Correo"
                                   required />
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Contraseña</label>

                        <div class="input-wrapper">
                            <span class="input-icon">●</span>

                            <input type="@TipoPassword"
                                   placeholder="Ingresa tu contraseña"
                                   @bind="Contrasena"
                                   required />

                            <button type="button"
                                    class="show-password"
                                    @onclick="AlternarPassword">
                                @(MostrarPassword ? "Ocultar" : "Ver")
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="login-button">
                        Iniciar sesión
                        <span>→</span>
                    </button>

                    @if (!string.IsNullOrEmpty(Mensaje))
                    {
                        <div class="login-message">
                            @Mensaje
                        </div>
                    }

                </form>

                <div class="security-note">
                    <span>●</span>
                    Acceso protegido para usuarios autorizados.
                </div>

            </div>

            <div class="form-footer">
                © 2026 SmartNutriTracker. Todos los derechos reservados.
            </div>

        </div>

    </div>

</div>

@code {

    private string Correo = "";
    private string Contrasena = "";

    private bool MostrarPassword = false;

    private string Mensaje = "";

    private string TipoPassword
    {
        get
        {
            if (MostrarPassword == true)
            {
                return "text";
            }
            else
            {
                return "password";
            }
        }
    }

    private void AlternarPassword()
    {
        MostrarPassword = !MostrarPassword;
    }

    private void IniciarSesion()
    {
        Mensaje = "La conexión de autenticación se implementará en el siguiente paso.";
    }
}
